POSTGRES_PASSWORD=replace-with-a-random-database-password
ADMIN_EMAIL=admin@selfguard.local
ADMIN_PASSWORD=replace-with-a-long-random-password
ENROLLMENT_TOKEN=replace-with-a-random-enrollment-token
WAF_TOKEN=replace-with-a-random-waf-token
# Generate private deployment keys with node scripts/provision-keys.cjs.
# Configure the signing trust before remote upgrade. The verified platform entry is trusted automatically; add other trusted release origins explicitly.
AGENT_UPGRADE_PUBLIC_KEY=
AGENT_UPGRADE_ORIGINS=

# Optional trusted CONNECT proxy for official intelligence HTTPS sources.
# Target public-address validation and official TLS verification remain enabled.
INTELLIGENCE_HTTPS_PROXY=
# Optional trusted public HTTPS DNS through that proxy when system DNS is unavailable.
INTELLIGENCE_PROXY_DNS_OVER_HTTPS=false
# Local development must point to a host-native archive reader built from services/intelligence.
INTELLIGENCE_ARCHIVE_READER=

# Optional fixed override; otherwise use the storage page quota (default 5 GiB).
# Set an absolute shared directory when API and sync tools use different working directories.
INTELLIGENCE_ARTIFACT_DIR=
INTELLIGENCE_ARTIFACT_QUOTA_BYTES=

# Deployment HTTP(S) entry for this platform; automatically verified and used by Agent onboarding.
AGENT_PLATFORM_URL=
AGENT_PLATFORM_CA_PEM=

# Optional credential for a separate local rule-check node; falls back to WAF_TOKEN.
WAF_TEST_TOKEN=
WAF_TEST_URL=

# Signed WAF publication remains closed until the documented runtime gates pass.
WAF_RULE_RUNTIME_ENABLED=false
WAF_RULE_SIGNING_KEY_FILE=

# Fixed WAF image IDs/digests, selected by the actual Agent architecture.
HOST_WAF_IMAGE=
HOST_WAF_IMAGE_ARM64=
HOST_WAF_IMAGE_AMD64=
# Optional private, regular docker-save archives (absolute paths; at most 64 MiB).
# The platform and Agent verify archive SHA-256, exact image ID and architecture.
HOST_WAF_IMAGE_ARCHIVE_ARM64=
HOST_WAF_IMAGE_ARCHIVE_AMD64=

# Encrypted request/response evidence, automatically inaccessible after 7 days.
ACCESS_EVIDENCE_DIR=.data/access-evidence
# Optional fixed byte ceiling; leave empty to use the managed storage policy.
ACCESS_EVIDENCE_MAX_BYTES=

# Fixed Nuclei 3.11.1 native response matcher. Runtime images bundle the verified engine.
# Local development: set absolute host-native executable; no target requests are delegated to Nuclei.
NUCLEI_BINARY=
# Optional persistent generic rule catalog/source/download paths (images set these under INTELLIGENCE_ARTIFACT_DIR).
PROBE_RULE_LIBRARY_DIR=
PROBE_RULE_LIBRARY_SOURCE=
PROBE_RULE_DOWNLOAD_DIR=
