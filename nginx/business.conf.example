# Include once from the existing tbtparent.me TLS server.
# /etc/nginx/business/tbtparent.me/self-guard.conf
# current -> /opt/self-guard/web/releases/<version>; archive contains self-guard/.
location = /self-guard {
    return 308 /self-guard/$is_args$args;
}
location ^~ /self-guard/api/ {
    proxy_pass http://127.0.0.1:31009;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 66m;
    proxy_read_timeout 300s;
}
location = /self-guard/healthz {
    proxy_pass http://127.0.0.1:31009;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
}
location ^~ /self-guard/assets/ {
    root /opt/self-guard/web/current;
    try_files $uri =404;
    add_header Cache-Control 'public, max-age=31536000, immutable';
}
location /self-guard/ {
    root /opt/self-guard/web/current;
    try_files $uri $uri/ /self-guard/index.html;
    add_header Cache-Control 'no-cache';
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
}
