# Confirmed: bundled PostgreSQL + host Nginx static frontend. No secrets in this example.
DB_MODE=bundled
WEB_MODE=static
COMPOSE_PROJECT_NAME=self-guard-production
BASE_PATH=/self-guard
APP_PORT=31009
# Exact digest references are generated in the version release manifest.
APP_IMAGE=ghcr.io/jojoshine/self-guard@sha256:REPLACE_FROM_RELEASE_MANIFEST
POSTGRES_IMAGE=postgres@sha256:REPLACE_FROM_RELEASE_MANIFEST
DATABASE_URL=postgresql://selfguard_runtime:REPLACE@postgres:5432/selfguard
MIGRATION_DATABASE_URL=postgresql://selfguard_migrator:REPLACE@postgres:5432/selfguard
TRUSTED_PROXY_CIDRS=loopback,REPLACE_COMPOSE_GATEWAY_IP/32
AGENT_PLATFORM_URL=https://tbtparent.me/self-guard
AGENT_UPGRADE_ORIGINS=
AGENT_UPGRADE_PUBLIC_KEY=REPLACE_WITH_TRUSTED_PUBLIC_KEY
DATA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTES_HEX_OR_RETAINED_MIGRATION_KEY
TASK_SIGNING_PRIVATE_KEY=REPLACE_WITH_PRIVATE_ED25519_PKCS8_BASE64
ENROLLMENT_TOKEN=REPLACE_WITH_RANDOM_TOKEN
