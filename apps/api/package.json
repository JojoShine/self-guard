    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tldts": "7.4.19",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "multer": "^2.5.0",
    "deepmerge-ts": "^8.0.0"
  }
