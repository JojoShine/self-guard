generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model User {
 operationalMonitors OperationalMonitor[]
 dataScope Json @default("{}")
 id String @id @default(uuid())
 email String @unique
 name String
 passwordHash String
 role String @default("VIEWER")
 disabled Boolean @default(false)
 createdAt DateTime @default(now())
 sessions Session[]
}
model Session {
 id String @id @default(uuid())
 tokenHash String @unique
 userId String
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 expiresAt DateTime
}
model Asset {
 operationalMonitor OperationalMonitor?
 networkSensors NetworkSensor[]
 networkSensorEvents NetworkSensorEvent[]
 trafficMonitors TrafficMonitor[]
 trafficMonitorWindows TrafficMonitorWindow[]
 remoteAccess AssetRemoteAccess?
 remoteJobs AssetRemoteJob[]
 executorPublicKey String?
 archivedAt DateTime?
 id String @id @default(uuid())
 identity String? @unique
 hostname String
 os String
 osDistribution String?
 osVersion String?
 ip String?
 business String?
 owner String?
 tags String[] @default([])
 importance String @default("NORMAL")
 inventory Json @default("{}")
 tokenHash String? @unique
 lastSeen DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 findings Finding[]
 tasks Task[]
 accessSources AccessSource[]
}
enum SecurityDomain {
 NETWORK
 DATA
 UNCLASSIFIED
}
model FindingTriage {
 findingId String @id
 finding Finding @relation(fields:[findingId],references:[id],onDelete:Cascade)
 conclusion String
 duplicateOfId String?
 duplicateOf Finding? @relation("DuplicateTarget",fields:[duplicateOfId],references:[id],onDelete:Restrict)
 reason String
 updatedBy String
 updatedAt DateTime @updatedAt
 @@index([duplicateOfId])
}
model Finding {
 triage FindingTriage?
 duplicateReports FindingTriage[] @relation("DuplicateTarget")
 networkSensorEvents NetworkSensorEvent[]
 securityDomain SecurityDomain @default(UNCLASSIFIED)
 instanceId String?
 instance DatabaseInstance? @relation(fields:[instanceId],references:[id],onDelete:Restrict)
 readAt DateTime?
 relatedRiskId String?
 id String @id @default(uuid())
 dedupKey String @unique
 externalId String
 title String
 kind String
 severity String
 status String @default("OPEN")
 source String
 evidence String
 assetId String?
 asset Asset? @relation(fields:[assetId],references:[id])
 owner String?
 reason String?
 expiresAt DateTime?
 dueAt DateTime?
 occurrences Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 tasks Task[]
 links IncidentFinding[]
 @@index([status,kind,severity])
 @@index([securityDomain,createdAt])
}
model Incident {
 type String @default("OTHER")
 assetIds String[] @default([])
 taskIds String[] @default([])
 remainingRisks String @default("")
 id String @id @default(uuid())
 title String
 severity String
 status String @default("OPEN")
 description String @default("")
 owner String?
 conclusion String?
 verification String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 links IncidentFinding[]
}
model IncidentFinding {
 incidentId String
 findingId String
 incident Incident @relation(fields:[incidentId],references:[id],onDelete:Cascade)
 finding Finding @relation(fields:[findingId],references:[id],onDelete:Cascade)
 @@id([incidentId,findingId])
}
model Rule {
 id String @id @default(uuid())
 intervalSeconds Int?
 nextRunAt DateTime?
 name String
 kind String
 enabled Boolean @default(true)
 severity String
 config Json
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Task {
 batchId String?
 notBefore DateTime?
 windowEnd DateTime?
 rollbackOf String?
 id String @id @default(uuid())
 title String
 assetId String
 asset Asset @relation(fields:[assetId],references:[id])
 findingId String?
 finding Finding? @relation(fields:[findingId],references:[id])
 template String
 templateVersion String @default("1")
 parameters Json
 status String @default("PENDING")
 requestedBy String
 approvedBy String?
 reason String?
 result Json?
 verification Json?
 expiresAt DateTime
 claimedAt DateTime?
 completedAt DateTime?
